{
  "expo": {
    "name": "ARK Driver",
    "slug": "arkdriver-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "driver",
    "ios": {
      "bundleIdentifier": "com.arkcarriers.driver",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "truckerpath",
          "com.sygic.truck",
          "hammer",
          "comgooglemaps",
          "maps",
          "waze"
        ]
      }
    },
    "android": {
      "package": "com.arkcarriers.driver"
    },
    "plugins": [
      "expo-router"
    ]
  }
}